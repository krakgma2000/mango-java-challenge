# JVM version, to compare with the native image (Dockerfile)

# ---- Build ----
FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

# Gradle wrapper and build files first, so the dependencies are cached as a layer
COPY gradlew settings.gradle build.gradle ./
COPY gradle gradle
RUN chmod +x gradlew && ./gradlew --no-daemon dependencies > /dev/null

COPY src src
RUN ./gradlew --no-daemon clean build

# ---- Runtime ----
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/build/libs/mango-app.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]